# AI-DS Visualizer Pro — Environment Variables Template
# Copy this file to .env or configure in your deployment platform (Vercel)

# Backend API Base URL (defaults to http://localhost:8000 if omitted)
VITE_API_URL=http://localhost:8000

# Optional Google OAuth Web Client ID for authentication
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
