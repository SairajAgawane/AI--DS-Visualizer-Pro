# Optional provider configuration. The local parser and tutor work without it.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
# Google Gemini API (optional). Set GEMINI_API_KEY to enable real AI Copilot responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CORS_ORIGINS=http://localhost:5173
AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
# Leave this as SQLite for local development. Replace it with the Supabase
# Session pooler URL to use the hosted PostgreSQL database.
DATABASE_URL=sqlite:///./sql_app.db
